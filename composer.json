{
  "name": "your-vendor/your-project",
  "description": "A clean PHPUnit boilerplate with logging, coverage-ready config, and CI",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.3"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "testdox": "phpunit --testdox",
    "test:coverage": "phpunit --coverage-text --coverage-html coverage"
  },
  "config": {
    "sort-packages": true
  }
}
