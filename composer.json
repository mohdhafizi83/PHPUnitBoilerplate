{
  "name": "your-vendor/your-project",
  "description": "A clean PHPUnit boilerplate with logging, coverage-ready config, and CI",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.4"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^13.3"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "testdox": "phpunit --testdox",
    "test:coverage": "XDEBUG_MODE=coverage phpunit --coverage-text --coverage-html coverage --coverage-clover coverage/clover.xml",
    "stan": "phpstan analyse --memory-limit=256M",
    "check": [
      "@stan",
      "@testdox"
    ]
  },
  "config": {
    "sort-packages": true
  }
}
